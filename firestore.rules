rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /product/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 메인 배너 등 사이트 공통 설정 (모든 방문자 읽기, 인증 사용자만 쓰기)
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
